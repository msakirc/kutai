{
  "service_name": "vercel",
  "base_url": "https://api.vercel.com",
  "auth_type": "bearer",
  "auth_header": "Authorization",
  "actions": {
    "list_deployments": {
      "method": "GET",
      "path": "/v6/deployments",
      "required_params": []
    },
    "deploy": {
      "method": "POST",
      "path": "/v13/deployments",
      "required_params": ["name", "gitSource"]
    },
    "get_deployment": {
      "method": "GET",
      "path": "/v13/deployments/{id}",
      "required_params": ["id"]
    },
    "list_projects": {
      "method": "GET",
      "path": "/v9/projects",
      "required_params": []
    }
  },
  "mock_responses": {
    "deploy": { "id": "dpl_mock123", "readyState": "QUEUED", "url": "mock-app.vercel.app" },
    "get_deployment": { "id": "dpl_mock123", "readyState": "READY", "url": "mock-app.vercel.app" }
  }
}
